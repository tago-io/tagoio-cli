    "envfile": "^7.1.0",
    "eventsource": "^4.1.0",
    "kleur": "^4.1.5",
    "luxon": "^3.7.2",
    "ora": "^9.4.0",
    "prompts": "^2.4.2",
    "string-comparison": "^1.3.0",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "@types/async": "^3.2.25",
    "@types/luxon": "^3.7.1",
