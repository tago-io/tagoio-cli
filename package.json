{
  "name": "@tago-io/cli",
  "version": "3.2.0",
  "description": "TagoIO Application CLI Node.JS",
  "main": "./build/index.js",
  "type": "module",
  "repository": "tago-io/tagoio-cli",
  "keywords": [
    "tago",
    "tagoio",
    "tago-io",
    "iot",
    "tago.io",
    "cli",
    "analysis",
    "device"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "files": [
    "build",
    "man"
  ],
  "scripts": {
    "man": "mkdir -p man && tsx src/lib/generate-man.ts > man/tagoio.1 && chmod 644 man/tagoio.1",
    "build": "npm run man && rm -rf ./build; tsc --build; chmod +x ./build/index.js",
    "prepublishOnly": "npm run man",
    "test": "vitest run",
    "test:single": "vitest --",
    "test:coverage": "vitest run --coverage",
    "linter": "oxlint --quiet",
    "linter:fix": "oxlint --quiet --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt"
  },
  "bin": {
    "tagoio": "./build/index.js"
  },
  "man": "./man/tagoio.1",
  "author": "TagoIO LLC",
  "license": "ISC",
  "dependencies": {
    "@tago-io/sdk": "^12.2.4",
    "async": "^3.2.6",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "envfile": "^7.1.0",
    "eventsource": "^4.1.0",
    "kleur": "^4.1.5",
    "luxon": "^3.7.2",
    "ora": "^9.4.0",
    "prompts": "^2.4.2",
    "string-comparison": "^1.3.0",
    "tsx": "^4.21.0",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "@types/async": "^3.2.25",
    "@types/luxon": "^3.7.1",
    "@types/node": "^25.6.0",
    "@types/prompts": "^2.4.9",
    "@types/unzipper": "^0.10.11",
    "@vitest/coverage-v8": "^4.1.5",
    "oxfmt": "^0.47.0",
    "oxlint": "1.62.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
